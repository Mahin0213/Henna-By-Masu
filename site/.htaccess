# Keep the server-side copy of enquiries private
<Files "enquiries.log">
  Require all denied
</Files>

# The mailbox password lives here, on the server only — never serve it
<FilesMatch "^enquiry-config.*\.php$">
  Require all denied
</FilesMatch>

# Serve the homepage at one URL only
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
