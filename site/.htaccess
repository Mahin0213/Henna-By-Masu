# Keep the server-side copy of enquiries private
<Files "enquiries.log">
  Require all denied
</Files>

# The mailbox password lives here, on the server only — never serve it
<FilesMatch "^enquiry-config.*\.php$">
  Require all denied
</FilesMatch>

# Serve the homepage at one URL only
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# www.hennabymasu.com currently answers on its own, so the whole site exists
# at two addresses. Every canonical tag already points at the bare domain;
# this makes the server agree instead of leaving it to Google to work out.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Branded 404 instead of the bare Apache page. 404.html is noindex.
ErrorDocument 404 /404.html
